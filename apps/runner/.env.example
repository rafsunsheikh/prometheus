# Copy to apps/runner/.env and fill in.

# Where the Cloudflare Worker lives.
PROMETHEUS_API_URL="https://prometheus-api.<your-subdomain>.workers.dev"

# Must match the RUNNER_TOKEN secret set on the Worker.
PROMETHEUS_RUNNER_TOKEN=""

# Path to the real Claude Code binary (not the shell function wrapper).
CLAUDE_BIN="$HOME/.local/bin/claude"

# Model alias for summarization: opus | sonnet | haiku
CLAUDE_MODEL="sonnet"

# Seconds between polls when the queue is empty.
POLL_INTERVAL="10"

# Approx characters per chunk sent to Claude in the map phase.
CHUNK_CHARS="120000"
