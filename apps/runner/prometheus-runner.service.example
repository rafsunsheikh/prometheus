# Keep the Socrates runner alive on a Linux home server (systemd).
#
# Install:
#   sed "s|__REPO__|/srv/prometheus|g; s|__USER__|$USER|g" \
#     apps/runner/prometheus-runner.service.example \
#     | sudo tee /etc/systemd/system/prometheus-runner.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now prometheus-runner
#
# Logs:  journalctl -u prometheus-runner -f
#
# Note: Claude Code must already be signed in AS THIS USER
# (run `claude` once interactively and complete the login) — the runner
# reuses those stored credentials.

[Unit]
Description=Prometheus Socrates runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/apps/runner
ExecStart=/usr/bin/env npx tsx src/index.ts
Restart=always
RestartSec=15
# Summarizing a long book is a long-running child process; give it room.
TimeoutStopSec=300
# Send SIGTERM to the runner only, never to the Claude process it is driving.
# Under the default (control-group) systemd signals the whole cgroup, killing
# the summarization mid-flight and discarding minutes of subscription usage —
# which makes the runner's own "finish the current job first" handler useless.
KillMode=mixed

[Install]
WantedBy=multi-user.target
